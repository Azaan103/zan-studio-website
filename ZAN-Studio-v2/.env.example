# Copy to .env  (never commit .env). Pick ONE provider.
VITE_FORM_PROVIDER=web3forms        # web3forms | formspree | custom
VITE_WEB3FORMS_KEY=                 # from web3forms.com (sends to your Gmail)
VITE_FORMSPREE_ID=                  # e.g. xabcdefg
VITE_FORM_ENDPOINT=                 # only for provider=custom
